               /projects/opt-3d-speckle-rgbd-cameras/logistics-bin-picking_hu7d9f782c519d87a7a638d8949c52cca4_148682_1200x1200_fit_q80_h2_lanczos_2.webp 1200w&#34;
               src=&#34;http://localhost:1313/projects/opt-3d-speckle-rgbd-cameras/logistics-bin-picking_hu7d9f782c519d87a7a638d8949c52cca4_148682_ad3ee896f32b9e312768ced6d3c7fc86.webp&#34;
