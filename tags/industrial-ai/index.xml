               src=&#34;http://localhost:1313/projects/opt-3d-algorithm-platform/pose-matching-codebook_hu3d8645ff3d6b07ca7c4dee95c94c9c4b_46944_83d2e63022af75484ea38b42f1a22682.webp&#34;
