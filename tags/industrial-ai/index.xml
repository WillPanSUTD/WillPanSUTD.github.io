               /projects/opt-3d-algorithm-platform/weld-defect-detection_hu472575a93e3aaf8efa037fbc9d7cc40e_19254_b902ea535a08b125327a7444ecdcf28e.webp 400w,
               /projects/opt-3d-algorithm-platform/weld-defect-detection_hu472575a93e3aaf8efa037fbc9d7cc40e_19254_2f692cf0ea8b9162b289fa595bad92cd.webp 760w,
