               /projects/opt-3d-algorithm-platform/mesh-processing-denoising_huaca845f420c3baff156c6c6aa2e02a56_79872_f80ccf8fad335fd7bbe92400d49c3519.webp 400w,
               /projects/opt-3d-algorithm-platform/mesh-processing-denoising_huaca845f420c3baff156c6c6aa2e02a56_79872_85ad5f6017533b38ca5df32604b734c9.webp 760w,
               /projects/opt-3d-algorithm-platform/mesh-processing-denoising_huaca845f420c3baff156c6c6aa2e02a56_79872_1200x1200_fit_q80_h2_lanczos_2.webp 1200w&#34;
               src=&#34;http://localhost:1313/projects/opt-3d-algorithm-platform/mesh-processing-denoising_huaca845f420c3baff156c6c6aa2e02a56_79872_f80ccf8fad335fd7bbe92400d49c3519.webp&#34;
