  &lt;div class=&#34;flex justify-center	&#34;&gt;
    &lt;div class=&#34;w-100&#34; &gt;&lt;img alt=&#34;Global registration&#34; srcset=&#34;
               /projects/3d-autoscan/3dscan-global-registration_huc4efc538bda26f788689caca0d67f04a_8158_fa4f6745f8de714f9956fc68c4293438.webp 400w,
               /projects/3d-autoscan/3dscan-global-registration_huc4efc538bda26f788689caca0d67f04a_8158_1ca39e59441ea2d7a83e563251149b56.webp 760w,
               /projects/3d-autoscan/3dscan-global-registration_huc4efc538bda26f788689caca0d67f04a_8158_1200x1200_fit_q80_h2_lanczos_2.webp 1200w&#34;
               src=&#34;http://localhost:1313/projects/3d-autoscan/3dscan-global-registration_huc4efc538bda26f788689caca0d67f04a_8158_fa4f6745f8de714f9956fc68c4293438.webp&#34;
