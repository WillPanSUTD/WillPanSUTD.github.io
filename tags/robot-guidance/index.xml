               src=&#34;http://localhost:1313/projects/opt-3d-structured-light-cameras/pixel-alignment_hud9d6e3be7a630f3f1988cf19549bfc8f_93022_64243aa8c4a365dc4863eaa5c0acf59a.webp&#34;
